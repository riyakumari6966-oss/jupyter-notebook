   "source": [
    "def PeakEle(nums):\n",
    "    left=0\n",
    "    right=len(nums)-1\n",
    "\n",
    "    while left<right:\n",
    "        mid=(left+right)//2\n",
    "\n",
    "        if nums[mid]>nums[mid+1]:\n",
    "            right=mid\n",
    "        else:\n",
    "            left=mid+1\n",
    "    return left\n",
    "\n",
    "nums=[1,2,3,1]\n",
    "print(PeakEle(nums))"
   ]
  }
 ],
