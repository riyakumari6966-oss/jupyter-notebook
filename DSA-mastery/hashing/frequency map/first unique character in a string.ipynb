   "source": [
    "def firstUniqueChar(s):\n",
    "    freq_s={}\n",
    "\n",
    "    for ch in s:\n",
    "        freq_s[ch]=freq_s.get(ch,0)+1\n",
    "    for i, ch in enumerate(s):\n",
    "        if freq_s[ch]==1:\n",
    "            return i\n",
    "    return -1\n",
    "\n",
    "s=\"loveleetcode\"\n",
    "print(firstUniqueChar(s))\n"
   ]
  }
