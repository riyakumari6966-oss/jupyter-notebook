   "source": [
    "def majorityElement(nums):\n",
    "    freq_nums={}\n",
    "    n=len(nums)\n",
    "    for num in nums:\n",
    "        freq_nums[num]=freq_nums.get(num,0)+1\n",
    "    for key in freq_nums:\n",
    "        if freq_nums[key]>(n//2):\n",
    "            return key\n",
    "    return 0\n",
    "\n",
    "nums=[3,2,3]\n",
    "print(majorityElement(nums))"
   ]
  }
 ],
