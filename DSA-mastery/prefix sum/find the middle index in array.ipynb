    "def MiddleIndex(nums):\n",
    "    left_sum=0\n",
    "    right_sum=sum(nums)\n",
    "\n",
    "    for i in range(len(nums)):\n",
    "        right_sum=sum(nums)-left_sum-nums[i]\n",
    "\n",
    "        if left_sum==right_sum:\n",
    "            return i\n",
    "        left_sum+=nums[i]\n",
    "    return -1\n",
    "\n",
    "nums=[1, 7, 3, 6, 5, 6]\n",
    "print(MiddleIndex(nums))"
   ]
  }
 ],
