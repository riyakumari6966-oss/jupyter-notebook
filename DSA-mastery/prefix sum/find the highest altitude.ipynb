   "source": [
    "def highestAltitude(gain):\n",
    "    current_gain=0\n",
    "    max_gain=0\n",
    "\n",
    "    for g in gain:\n",
    "        current_gain+=g\n",
    "        max_gain=max(current_gain,max_gain)\n",
    "    return max_gain\n",
    "\n",
    "gain=[-5,1,5,0,-7]\n",
    "print(highestAltitude(gain))"
   ]
  }
 ],
