    "def IsSequence(s,t):\n",
    "    left=0\n",
    "    right=0\n",
    "\n",
    "    while left<len(s) and right<len(t):\n",
    "        if s[left]==t[right]:\n",
    "            left+=1\n",
    "        right+=1\n",
    "    return left==len(s)\n",
    "s=\"ace\"\n",
    "t=\"abjchqe\"\n",
    "print(IsSequence(s,t))"
   ]
  }
