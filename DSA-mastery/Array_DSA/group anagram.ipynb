   "source": [
    "def grpAnagram(strs):\n",
    "    freq={}\n",
    "\n",
    "    for word in strs:\n",
    "        key=\"\".join(sorted(word))\n",
    "        if key not in freq:\n",
    "            freq[key]=[]\n",
    "        freq[key].append(word)\n",
    "    return list(freq.values())\n",
    "\n",
    "strs=[\"eat\",\"tea\",\"tan\",\"ate\",\"nat\",\"bat\"]\n",
    "print(grpAnagram(strs))"
   ]
  }
 ],
