   "source": [
    "def deleteMiddle(head):\n",
    "    if not head or not head.next:\n",
    "        return None\n",
    "\n",
    "    slow=head\n",
    "    fast=head\n",
    "    prev=None\n",
    "\n",
    "    while fast and fast.next:\n",
    "        prev=slow\n",
    "        slow=slow.next\n",
    "        fast=fast.next.next\n",
    "    prev.next=slow.next\n",
    "    return head"
   ]
  }
 ],
