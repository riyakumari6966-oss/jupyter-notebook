    "def events_conflict(event1,event2):\n",
    "    if event2[0]<=event1[1] and event2[1]>=event1[0]:\n",
    "        return True\n",
    "    else:\n",
    "        return False\n",
    "\n",
    "event1=[\"02:00\",\"03:00\"]\n",
    "event2=[\"01:00\",\"01:30\"]\n",
    "events_conflict(event1,event2)"
   ]
  }
