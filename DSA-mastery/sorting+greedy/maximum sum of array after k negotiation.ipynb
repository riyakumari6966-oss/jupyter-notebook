   "source": [
    "def maxSum(nums,k):\n",
    "    nums.sort()\n",
    "    for i in range(len(nums)):\n",
    "        if nums[i]<0 and k>0:\n",
    "            nums[i]=-nums[i]\n",
    "            k-=1\n",
    "    if k%2==1:\n",
    "        return sum(nums)-2*min(nums)\n",
    "    return sum(nums)\n",
    "\n",
    "nums=[4, 2, 3]\n",
    "k=1\n",
    "print(maxSum(nums,k))"
   ]
  }
 ],
