   "source": [
    "def jumpGame(nums):\n",
    "    max_reach=0\n",
    "    for i, jump in enumerate(nums):\n",
    "        if i>max_reach:\n",
    "            return False\n",
    "        max_reach=max(max_reach, i+jump)\n",
    "\n",
    "        if max_reach>len(nums)-1:\n",
    "            return True\n",
    "    return True\n",
    "\n",
    "nums=[2,3,1,1,4]\n",
    "print(jumpGame(nums))"
   ]
  }
 ],
