   "source": [
    "def assignCookies(g,s):\n",
    "    g.sort()\n",
    "    s.sort()\n",
    "    child_i=0\n",
    "    cookie_j=0\n",
    "    while child_i<len(g) and cookie_j<len(s):\n",
    "        if g[child_i]<=s[cookie_j]:\n",
    "            child_i+=1\n",
    "        cookie_j+=1\n",
    "    return child_i\n",
    "g=[1,2,3]\n",
    "s=[1,1]\n",
    "print(assignCookies(g,s))"
   ]
  }
