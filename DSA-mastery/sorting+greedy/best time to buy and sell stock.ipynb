   "source": [
    "def bestTime(prices):\n",
    "    min_price=float('inf')\n",
    "    max_profit=0\n",
    "\n",
    "    for price in prices:\n",
    "        if price<min_price:\n",
    "            min_price=price\n",
    "        else:\n",
    "            max_profit=max(max_profit,price-min_price)\n",
    "    return max_profit\n",
    "\n",
    "prices=[7,1,5,3,6,4]\n",
    "print(bestTime(prices))"
   ]
  }
 ],
