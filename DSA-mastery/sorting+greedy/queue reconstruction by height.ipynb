   "source": [
    "def queueConstruction(people):\n",
    "    people.sort(key=lambda x:(-x[0], x[1]))\n",
    "    result=[]\n",
    "\n",
    "    for p in people:\n",
    "        result.insert(p[1],p)\n",
    "    return result\n",
    "\n",
    "people=[[7,0],[4,4],[7,1],[5,0],[6,1],[5,2]]\n",
    "print(queueConstruction(people))"
   ]
  }
 ],
