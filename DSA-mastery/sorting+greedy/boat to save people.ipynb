   "source": [
    "def boat(people,limit):\n",
    "    people.sort()\n",
    "\n",
    "    left=0\n",
    "    right=len(people)-1\n",
    "    boat=0\n",
    "\n",
    "    while left<=right:\n",
    "        if people[left]+people[right]<=limit:\n",
    "            left+=1\n",
    "        right-=1\n",
    "        boat+=1\n",
    "    return boat\n",
    "\n",
    "people=[3,5,3,4]\n",
    "limit=5\n",
    "print(boat(people,limit))"
   ]
  }
 ],
