   "source": [
    "def largestPerimeter(nums):\n",
    "    nums.sort(reverse=True)\n",
    "    for i in range(len(nums)-2):\n",
    "        if nums[i+1]+nums[i+2]>nums[i]:\n",
    "            return nums[i]+nums[i+1]+nums[i+2]\n",
    "    return 0\n",
    "\n",
    "nums=[2, 1, 2]\n",
    "print(largestPerimeter(nums))"
   ]
  }
