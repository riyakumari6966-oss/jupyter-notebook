   "source": [
    "def containNearbyDuplicate(nums,k):\n",
    "    last_seen={}\n",
    "\n",
    "    for i, num in enumerate(nums):\n",
    "        if num in last_seen and i-last_seen[num]<=k:\n",
    "            return True\n",
    "        last_seen[num]=i\n",
    "    return False\n",
    "\n",
    "nums=[1,2,3,1]\n",
    "k=3\n",
    "print(containNearbyDuplicate(nums,k))"
   ]
  }
 ],
